# Mini App (exposed to the browser by Vite). Never commit a real Client ID.
# Create one at https://panel.getfaceage.com/
VITE_FACEAGE_CLIENT_ID=

# Optional overrides. Sample catalog values are used when these are empty.
VITE_SHOP_NAME=
VITE_CURRENCY=
VITE_BOT_USERNAME=

# Bot process / Vercel functions. Never expose the token to the Mini App.
BOT_TOKEN=
MINI_APP_URL=http://localhost:5173
ORDER_BASE_URL=https://example.com/checkout
SHOP_NAME=
CURRENCY=
